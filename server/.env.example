# Family Hub — production environment variables
# Copy this file to .env and fill in the values before running docker compose.

# --- Required ---

# OpenID Connect issuer URL (e.g. https://auth.example.com, https://accounts.google.com)
OIDC_ISSUER=https://auth.example.com

# OAuth2 client ID registered with your OIDC provider
OIDC_CLIENT_ID=family-hub

# --- Optional ---

# Path to the SQLite database file (default: ./data/family-hub.db)
DATABASE_PATH=./data/family-hub.db

# Server port (default: 8080)
PORT=8080

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Train provider URL (default: https://huxley2.azurewebsites.net)
HUXLEY_BASE_URL=https://huxley2.azurewebsites.net

# National Rail access token. Leave empty to disable commute data.
HUXLEY_ACCESS_TOKEN=

# Google Geocoding and Routes APIs for departure estimates.
GOOGLE_MAPS_API_KEY=

# Apple push notifications. Set all four values together, or leave all empty.
APNS_KEY_ID=
APNS_TEAM_ID=
# Must match the iPhone app bundle identifier, including its letter case.
APNS_TOPIC=
# Path inside the server process. The push Compose overlay sets this path.
APNS_KEY_PATH=
# Absolute host path for the push Compose overlay. Keep the .p8 file outside the repo.
APNS_KEY_FILE=
